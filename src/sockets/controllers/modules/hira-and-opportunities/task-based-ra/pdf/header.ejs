
<div id="pageHeader-first" class="header"></div>
<div id="pageHeader" class="header">
    <table style="border: none; width: 100%;">
        <tr>
            <td style="border: none; border-right: 1px dashed #ddd; width: 170px;"></td>
            <td style="border: none;">
                <table style="border: none; width: 100%; height: 100%">
                    <tr>
                        <td style="border: none;">
                            <h2 style="text-align: center"><%= companyName%></h2>
                            <h2 style="text-align: center"><%= title%></h2>
                        </td>
                    </tr>
                </table>
            </td>
            <td style="border: none; border-left: 1px dashed #eee; width: 170px;">
                <p style="margin: 0 0 2px; padding-bottom: 2px; border-bottom: 1px dotted #eee; margin-left: 10px;"><b style="width: 100px; text-align: right">Document No:</b> <%= docNum%></p>
                <p style="margin: 0 0 2px; padding-bottom: 2px; border-bottom: 1px dotted #eee; margin-left: 10px;"><b style="width: 100px; text-align: right">Revision No:</b> <%= revNum%></p>
                <p style="margin: 0 0 2px; padding-bottom: 2px; border-bottom: 1px dotted #eee; margin-left: 10px;"><b style="width: 100px; text-align: right">Revision Date:</b> <%= revDate%></p>
                <p style="margin: 0; padding-bottom: 2px; margin-left: 10px;">Page {{page}} of {{pages}}</p>
            </td>
        </tr>
    </table>
</div>