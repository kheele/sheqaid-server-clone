<!DOCTYPE html>
<html>
    <head>
        <style>
            * {
                font-family: "Roboto Medium";
                box-sizing: border-box;
            }
            .wrapper {
                display: block;
                margin: 0px;
            }
            .section {
                margin-bottom: 20px;
            }
            .section > h4,
            .section > ul,
            .section > p {
                margin-left: 20px
            }
            .page-title {
                text-align: center;
            }
            h1 {
                font-size: 19px;
            }
            h2 {
                font-size: 17px;
            }
            h3 {
                font-size: 15px;
            }
            h4, p, li, td, th {
                font-size: 12px;
            }

            .flex{
                display: -webkit-flex;
                -webkit-flex-wrap: wrap;
            }
            .flex > *{
                flex: 1;
                -webkit-flex: 1;
            }
            .fixed-flex{
                -webkit-flex-grow: initial !important;
            }

            .table{
                display: block;
                background: #fff;
                position: relative;
            }
            .table > .thead{
                display: -webkit-flex;
                border-bottom: 2px solid #ddd;
                background: #f6f6f6;
            }
            .table > .thead > .td{
                flex: 1;
                -webkit-flex: 1;
                padding: 5px 0;
                font-weight: bold;
                color: #888;
                font-size: 11px;
                border: 1px solid #ddd;
                border-left: none;
            }
            .table > .tbody{
                display: block;
            }
            .table > .tbody .tr{
                border-bottom: 2px solid #eee;
                position: relative;
            }
            .table > .tbody .tr:not(.tr-table){
                display: -webkit-flex;
                padding-left: 5px;
                padding-right: 5px;

            }
            .table > .tbody .tr-table{
                display: block;
                padding-left: 0;
                padding-right: 0;
            }
            .table > .tbody .tr-table > .table .thead,
            .table > .tbody .tr-table > .tr{
                background: none;
            }
            .table > .tbody .tr-table > .table{
                margin: 10px !important;
                width: calc(100% - 20px) !important;
                transition: all 2s;
            }
            .table > .tbody .tr-table > .table .thead .td{
                font-size: 12px;
                font-weight: normal;
                font-style: italic;
            }
            .table > .tbody .tr-table > .table .tbody .td{
                padding: 5px 0;
                font-style: italic;
            }
            .table > .tbody .td > span{
                background: #f7f7f7;
                padding: 3px 3px;
                display: block;
                margin-right: 3px;
                border-radius: 8px;
                height: 100%;
                font-size: 12px;
            }
            .table > .tbody .tr > .td:first-of-type > span{
                background: #f7f7f7;
                padding: 3px 3px;
                display: inline;
                margin-right: 3px;
                border-radius: 50%;
                height: 30px;
            }
            .table > .tbody .tr > .td{
                flex: 1;
                border-right: 1px solid #eee;
                -webkit-flex: 1;
                padding: 5px 0;
                font-weight: 400;
                color: #888;
                font-size: 12px;
                position: relative;
            }

            .table > .thead .td-rotate{
                -webkit-transform: rotate(-90deg);
                min-width: 95px;
                height: 30px;
                min-height: 30px;
                max-height: 30px;
                border: 1px solid #ddd;
                border-top-width: 0px;
                border-left-width: 0px;
                border-right: 0px;
                margin: 32px -29px 0 -30px;
                padding: 6px 8px;
            }
            .table > .thead .td-rotate:last-of-type{
                border-bottom-width: 0px;
            }

            .table .td.td-rotate-single{
                padding: 7px 8px !important;
                min-width: 30px !important;
                position: relative;
                border-right: 1px solid #ddd;
            }
            .table .td.td-rotate-single:last-of-type{
                border-right: 0px;
            }
            .table .td.td-rotate-single span {
                -webkit-transform: rotate(-90deg);
                min-width: 107px;
                height: 30px;
                max-height: 30px;
                left: -39px;
                top: 40px;
                overflow: hidden;
                right: 0;
                bottom: 0;
                position: absolute;
                padding: 8px 5px;
                background: none;
            }
            .table .td.td-rotate-single-risk span {
                min-width: 85px;
                left: -28px;
                top: 25px;
            }

            .table > .tbody > .tr {
                padding: 0 !important;
                height: 100px;
            }
            .table > .tbody > .tr > .td > span{
                height: auto;
            }
            .table > .tbody > .tr .td.td-calc {
                height: 100%;
                text-align: center;
                padding: 5px 0;
            }
            .table > .tbody > .tr .td.td-calc {
                border-right: 1px solid #eee;
            }
            .table > .tbody > .tr > .td:last-of-type {
                padding: 0 !important;
            }
            
            .padding-0 {
                padding: 0px !important;
            }

            .h-125 {height: 125px !important; }
            .min-w-90 {min-width: 90px !important; }
            .min-w-125 {min-width: 125px !important; }
            .min-w-180 {min-width: 180px !important; }

            #pageHeader {
                text-align: center; border-bottom: 1px solid #ddd; margin-bottom: 20px; width: 100%;
            }
            .footer {
                text-align: center; border-top: 1px solid #ddd; padding: 5px 0; color: #888; font-size: 9px; max-height: 20px; margin-top: 55px;
            }
            .footer > span{
                float: right;
            }
        </style>
    </head>
    <body>
        <div class="wrapper">
            <%- include('coverpage', {title: 'Baseline'}); %>
            <div class="section">          
                <div class="table">
                    <%- include('report-ra-head', {list, hasFrequency: true}); %>
                    <%- include('report-ra-body', {list, hasFrequency: true}); %>
                </div>
            </div>
        </div>
        <%- include('header', {title: 'Baseline Risk Assessment', companyName: 'Company Name', docNum: '2', revNum: '2', revDate: '22-March-2022'}); %>
        <%- include('../../pdf/footer'); %>
    </body>
</html>
